        {
            "language": [
                "latex",
                {
                    "pattern": "**/*.{tex}"
                }
            ],
            "substitutions": [
                {
                    "ugly": "\\\\iiint",
                    "pretty": "∭"
                },
                {
                    "ugly": "\\\\iint",
                    "pretty": "∬"
                },
